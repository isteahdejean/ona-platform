generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Les 4 profils d'inscription decrits par l'ONA, + un role admin/moderation
// interne (non auto-selectionnable a l'inscription).
enum Role {
  PRODUCTEUR // employe / producteur d'idees : publie des reflexions
  ASSURE
  PENSIONNE
  SYNDICAT // groupes syndicaux et groupes organises de l'institution
  DIRECTION // membre d'une direction de l'institution
  ADMIN
}

// Distingue une reflexion ordinaire de la revue hebdomadaire (contenu edite
// et publie manuellement chaque semaine, affiche dans une section a part).
enum TypeContenu {
  REFLEXION
  REVUE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // pour la connexion par email/mot de passe (assures/pensionnes sans compte Google)
  role          Role?
  directionId   String?
  direction     Direction?    @relation(fields: [directionId], references: [id])
  accounts      Account[]
  sessions      Session[]
  reflexions    Reflexion[]
  commentaires  Commentaire[]
  createdAt     DateTime      @default(now())

  @@index([role])
}

// Directions internes de l'institution (ex: Direction des prestations,
// Direction financiere, etc.) — a peupler selon l'organigramme reel.
model Direction {
  id    String @id @default(cuid())
  nom   String @unique
  users User[]
}

model Reflexion {
  id           String        @id @default(cuid())
  titre        String
  contenu      String
  type         TypeContenu   @default(REFLEXION)
  publie       Boolean       @default(false)
  auteurId     String
  auteur       User          @relation(fields: [auteurId], references: [id])
  commentaires Commentaire[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([auteurId])
  @@index([publie, createdAt])
  @@index([type, publie, createdAt])
}

// parentId permet des fils de discussion (reponses a un commentaire) ;
// le nombre de commentaires par reflexion n'est pas limite par le schema.
model Commentaire {
  id          String        @id @default(cuid())
  contenu     String
  auteurId    String
  auteur      User          @relation(fields: [auteurId], references: [id])
  reflexionId String
  reflexion   Reflexion     @relation(fields: [reflexionId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Commentaire?  @relation("Reponses", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reponses    Commentaire[] @relation("Reponses")
  createdAt   DateTime      @default(now())

  @@index([reflexionId])
  @@index([parentId])
}

// --- Modeles requis par NextAuth (adapter Prisma) ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
